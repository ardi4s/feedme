# Everything is text with LF endings, so a checkout on any platform produces
# the same bytes the tests were written against.
* text=auto eol=lf

# Images are bytes, not lines: never diff them as text.
*.png binary
*.ico binary

# The brand images are generated by tools/brand.py. Keeping them out of the
# language statistics stops a generated PNG from outweighing the Go source.
internal/web/assets/*.png linguist-generated
internal/web/assets/*.ico linguist-generated
docs/brand/*.png linguist-generated
